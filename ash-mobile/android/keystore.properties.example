# Copy this file to "keystore.properties" (same folder) and fill in the
# real values. keystore.properties itself is git-ignored — never commit it
# or the .keystore file to version control.
#
# storeFile is relative to android/app/
storeFile=ash_project.keystore
storePassword=CHANGE_ME
keyAlias=ash_project
keyPassword=CHANGE_ME
