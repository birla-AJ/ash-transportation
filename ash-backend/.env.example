# App
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
CORS_ORIGIN=http://localhost:3001,http://localhost:19006

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/ash_transportation

# JWT
JWT_ACCESS_SECRET=change_this_access_secret_in_production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change_this_refresh_secret_in_production
JWT_REFRESH_EXPIRES_IN=30d
JWT_REFRESH_EXPIRES_IN_REMEMBER=90d

# Bootstrap Admin (created automatically on first boot if no user exists)
ADMIN_EMAIL=admin@ashtransportation.com
ADMIN_PASSWORD=ChangeMe@123
ADMIN_NAME=Administrator

# Challan
CHALLAN_PREFIX=ASH
CHALLAN_PAD_LENGTH=6

# Logging
LOG_LEVEL=info
