generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String    @id @default(uuid())
  name               String
  email              String    @unique
  password           String
  role               String    @default("admin")
  isActive           Boolean   @default(true)
  // Base64 data URL of the admin's signature (e.g. "data:image/png;base64,...").
  // Set by the Sub Admin when adding/editing an Admin. Printed on every
  // challan that admin creates, in place of the old hardcoded email->file map.
  signatureImage     String?
  lastLoginAt        DateTime?
  refreshTokenHashes String[]  @default([])
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  createdChallans     Challan[]     @relation("ChallanCreatedBy")
  updatedChallans     Challan[]     @relation("ChallanUpdatedBy")
  deletedChallans     Challan[]     @relation("ChallanDeletedBy")
  auditLogs           AuditLog[]    @relation("AuditPerformedBy")
  createdTransporters Transporter[] @relation("TransporterCreatedBy")

  @@map("users")
}

model Challan {
  id              String    @id @default(uuid())
  challanNumber   String    @unique
  challanSequence Int
  truckNumber     String
  placeOfDelivery String
  // driverName/driverNumber/managerName are only collected + printed for
  // transporters whose challan template is VEDANT_LOADING_TOKEN (see
  // Transporter.templateType) — left blank for the standard NTPC design.
  driverName      String?
  driverNumber    String?
  managerName     String?
  challanDate     DateTime
  challanTime     String
  isDeleted       Boolean   @default(false)
  deletedAt       DateTime?
  deletedReason   String?

  deletedBy     String?
  deletedByUser User?   @relation("ChallanDeletedBy", fields: [deletedBy], references: [id])

  createdBy     String
  createdByUser User   @relation("ChallanCreatedBy", fields: [createdBy], references: [id])

  updatedBy     String?
  updatedByUser User?   @relation("ChallanUpdatedBy", fields: [updatedBy], references: [id])

  // Nullable so the 14 challans created before this feature don't break —
  // every new challan going forward is required (by the API layer) to pick one.
  transporterId String?
  transporter   Transporter? @relation(fields: [transporterId], references: [id])

  printCount    Int       @default(0)
  lastPrintedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([truckNumber])
  @@index([placeOfDelivery])
  @@index([challanDate])
  @@index([isDeleted])
  @@index([createdAt])
  @@index([updatedAt])
  @@index([transporterId])
  @@map("challans")
}

/// A transporter company Sub Admins maintain — printed as the "Transporter
/// Name" / "Add:" block on every challan, selected from a dropdown when an
/// Admin creates one.
model Transporter {
  id       String  @id @default(uuid())
  name     String
  address  String
  isActive Boolean @default(true)
  // Which printed challan layout this transporter uses:
  // - "NTPC_CHALLAN": the standard NTPC Khargone consignment design
  //   (Truck No / Place of Delivery, "Issued to" line, etc.)
  // - "VEDANT_LOADING_TOKEN": Vedant Transport Carrier's own Loading Token
  //   design (Voucher No / Party Name / Vehicle No / Driver Name / Driver
  //   Number / Manager).
  // Set by the Sub Admin when adding the transporter; drives which React
  // component the website/mobile Receipt renders for that transporter's
  // challans.
  templateType String @default("NTPC_CHALLAN")

  createdBy     String
  createdByUser User   @relation("TransporterCreatedBy", fields: [createdBy], references: [id])

  challans Challan[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
  @@map("transporters")
}

/// Single-row counter used with an atomic upsert+increment to generate
/// strictly increasing challan sequence numbers. Deleted challans never
/// decrement it, so a number is never reused.
model ChallanCounter {
  id       String @id @default(uuid())
  key      String @unique @default("challan_sequence")
  sequence Int    @default(0)

  @@map("challan_counters")
}

model Settings {
  id                 String   @id @default(uuid())
  key                String   @unique @default("app_settings")
  companyName        String   @default("Ash Transportation")
  companyAddress     String   @default("")
  companyPhone       String   @default("")
  copiesPerPrint     Int      @default(4)
  printerType        String   @default("ESCPOS")
  printerName        String   @default("")
  printerWidthMm     Int      @default(80)
  printerCalibration Json     @default("{}")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@map("settings")
}

model AuditLog {
  id     String  @id @default(uuid())
  action String
  entityType String
  entityId   String?

  performedBy     String
  performedByUser User   @relation("AuditPerformedBy", fields: [performedBy], references: [id])

  before    Json?
  after     Json?
  reason    String?
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([action])
  @@index([entityType])
  @@index([performedBy])
  @@index([createdAt])
  @@map("audit_logs")
}
